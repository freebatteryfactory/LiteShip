{
  // The specification and everything that attacks it: semantic declarations,
  // their laws, and compile-use fixtures.
  //
  // This is the checking population and the default project, so `tsc` with no
  // argument checks the largest thing. It emits nothing — a law is a question
  // asked of the compiler, and a question has no output.
  //
  // The split into three configurations arrived with a measured need, not with
  // a preference for structure. Laws were exported from semantic files, so all
  // 670 of them appeared in the emitted declaration surface; separating the
  // populations is what lets the declaration lane emit the specification alone
  // and inspect what came out. One configuration per home remains the thing
  // this repository refuses.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  // Everything. Not a governed-root list — a directory the census forgets is
  // exactly how `verification/` escaped for its entire existence.
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
