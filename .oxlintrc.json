{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "deny"
  },
  "rules": {
    "eqeqeq": "deny",
    "no-self-compare": "deny",
    "no-array-constructor": "deny",
    "require-unicode-regexp": "deny",
    "prefer-at": "deny",
    "prefer-string-replace-all": "deny",
    "prefer-import-meta-properties": "deny"
  },
  "ignorePatterns": [
    "node_modules"
  ]
}
